#Setting password
$Password = Read-Host -AsSecureString

<NQq\T011;>H

Set-LocalUser -Name "Administrator" -Password $Password

# 1. Disable LLMNR (Link-Local Multicast Name Resolution)
# Prevents LLMNR spoofing attacks (e.g., Responder tool)
$DnscachePath = "HKLM:\Software\Policies\Microsoft\Windows NT\DNSClient"

if (-not (Test-Path $DnscachePath)) { New-Item -Path $DnscachePath -Force | Out-Null }
New-ItemProperty -Path $DnscachePath -Name "EnableMulticast" -Value 0 -PropertyType DWord -Force | Out-Null

# 2. Disable NetBIOS over TCP/IP (NBT-NS)
# Disables NetBIOS name resolution on all network adapters
$Adapters = Get-CimInstance -ClassName Win32_NetworkAdapterConfiguration -Filter "IPEnabled = True"

foreach ($Adapter in $Adapters) {
    # Value 2 disables NetBIOS over TCP/IP
    Invoke-CimMethod -InputObject $Adapter -MethodName SetTCPIPNetBIOS -Arguments @{TcpipNetbiosOptions = 2} | Out-Null
}

